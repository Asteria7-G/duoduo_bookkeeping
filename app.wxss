@import "./theme/cat.wxss";
@import "./theme/handwriting.wxss";
page { min-height:100%; font-family:"DodoHand","Kaiti SC","STKaiti","KaiTi",sans-serif; font-size:28rpx; line-height:1.6; }
button { font:inherit; } button::after { border:0; }
.page { min-height:100vh; box-sizing:border-box; padding:0 32rpx calc(176rpx + env(safe-area-inset-bottom)); }
.safe-top { height:env(safe-area-inset-top); min-height:64rpx; }
.nav { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-right:184rpx; }
.nav-title { font-size:36rpx; font-weight:700; letter-spacing:-1rpx; }
.nav-action { min-width:72rpx; min-height:88rpx; line-height:88rpx; color:var(--mint-deep); font-weight:600; text-align:right; }
.back { flex:none; width:80rpx; height:88rpx; display:flex; align-items:center; justify-content:center; font-size:48rpx; }
.card { background:var(--surface); border:1rpx solid var(--line); border-radius:28rpx; box-shadow:0 8rpx 28rpx rgba(46,45,34,.025); }
.section-title { margin:36rpx 0 20rpx; font-size:30rpx; font-weight:650; letter-spacing:-.5rpx; }
.muted { color:var(--muted); } .money { font-variant-numeric:tabular-nums; letter-spacing:-1rpx; }
.primary-button { background:var(--mint-deep); color:#fffdf5; border-radius:22rpx; font-weight:600; line-height:96rpx; }
.secondary-button { background:#e9ede3; color:var(--mint-deep); border-radius:22rpx; line-height:88rpx; font-weight:600; }
.empty { text-align:center; color:var(--muted); padding:64rpx 24rpx; }
.field-card { background:var(--surface); border:1rpx solid var(--line); border-radius:26rpx; padding:0 24rpx; margin-bottom:24rpx; }
.field-row { min-height:112rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; border-bottom:1rpx solid var(--line); }
.field-row:last-child { border-bottom:0; } .field-label { flex:none; font-weight:500; }
.field-input { flex:1; min-width:0; text-align:right; color:var(--ink); }
.pill { display:inline-flex; padding:12rpx 22rpx; border-radius:999rpx; background:#e9ede3; color:var(--mint-deep); }
.pill.active { background:var(--mint-deep); color:#fffdf5; }
.fab-shadow { box-shadow:0 8rpx 24rpx rgba(48,64,49,.16); }
@import "./theme/journal.wxss";
