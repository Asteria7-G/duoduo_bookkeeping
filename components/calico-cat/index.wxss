.calico-scene { position:relative; width:100%; height:100%; overflow:hidden; pointer-events:none; }
.calico-scene .scene-layer,.calico-scene .cat-breath { position:absolute; display:block; top:0; left:0; width:100%; height:100%; }
.cat-breath { transform-origin:48% 84%; animation:calico-breathe 3.6s ease-in-out infinite; }
.cat-tail { transform-origin:59% 76%; animation:calico-tail 2.8s ease-in-out infinite; }
.cat-eyes-open { opacity:1; animation:calico-eyes-open 6.8s linear infinite; }
.cat-eyes-closed { opacity:0; animation:calico-eyes-closed 6.8s linear infinite; }
@keyframes calico-breathe { 0%,100% { transform:translateY(0) scaleY(1); } 50% { transform:translateY(-1px) scaleY(1.018); } }
@keyframes calico-tail { 0%,100% { transform:rotate(-7deg); } 50% { transform:rotate(9deg); } }
@keyframes calico-eyes-open { 0%,41%,46%,90%,95%,100% { opacity:1; } 42%,45%,91%,94% { opacity:0; } }
@keyframes calico-eyes-closed { 0%,41%,46%,90%,95%,100% { opacity:0; } 42%,45%,91%,94% { opacity:1; } }
@media (prefers-reduced-motion:reduce) { .cat-breath,.cat-tail,.cat-eyes-open,.cat-eyes-closed { animation:none; } }
