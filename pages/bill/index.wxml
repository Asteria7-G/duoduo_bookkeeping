<view class="page bill-page"><view class="safe-top"></view><view class="nav"><view class="back" bindtap="back">‹</view><view class="mode-tabs"><view data-mode="month" bindtap="setMode" class="{{mode==='month'?'active':''}}">月账单</view><view data-mode="year" bindtap="setMode" class="{{mode==='year'?'active':''}}">年账单</view></view><view class="nav-action"></view></view><view class="filter-row"><picker mode="date" fields="year" value="{{year}}" bindchange="year"><view>{{year}}年　⌄</view></picker><picker range="{{ledgers}}" range-key="name" value="{{ledgerIndex}}" bindchange="ledger"><view class="ledger-filter">{{ledgers[ledgerIndex].name}}　⌄</view></picker></view><view class="bill-hero card"><text class="hero-label">{{mode==='month'?'年度总支出':'所选年度支出'}}</text><text class="hero-money money">¥ {{summary.total}}</text><text class="hero-average">{{mode==='month'?'月均':'年度均值'}} ¥ {{summary.average}}</text><view class="hero-flower">✿</view></view><view class="table card"><view class="table-head"><text>{{mode==='month'?'月份':'年份'}}</text><text>笔数</text><text>支出</text><text>{{mode==='month'?'日均':'月均'}}</text></view><view wx:for="{{rows}}" wx:key="label" class="table-row"><text class="row-label">{{item.label}}</text><text>{{item.count}}</text><text>{{item.value}}</text><text>{{item.avg}}</text></view></view></view>
