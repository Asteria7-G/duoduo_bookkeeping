.bill-page{background:linear-gradient(180deg,#fff5d7,#f6faf7 500rpx)}.mode-tabs{display:flex;background:rgba(255,255,255,.68);border-radius:99rpx;padding:6rpx}.mode-tabs view{padding:12rpx 28rpx;border-radius:99rpx;color:#837a64}.mode-tabs .active{background:#24312d;color:#fff}.filter-row{display:flex;justify-content:space-between;align-items:center;margin:18rpx 0 24rpx;font-weight:700}.ledger-filter{background:#fff;padding:14rpx 20rpx;border-radius:99rpx}.bill-hero{position:relative;overflow:hidden;padding:34rpx;background:linear-gradient(135deg,#ffd875,#ffe9aa)}.hero-label,.hero-money,.hero-average{display:block}.hero-label{color:#7d6b39}.hero-money{font-size:58rpx;font-weight:850;margin:14rpx 0}.hero-average{font-size:24rpx;color:#776b4b}.hero-flower{position:absolute;right:34rpx;bottom:14rpx;font-size:100rpx;color:rgba(255,255,255,.45)}.table{margin-top:26rpx;overflow:hidden}.table-head,.table-row{display:grid;grid-template-columns:1.1fr .7fr 1.1fr 1.1fr;align-items:center;min-height:84rpx;padding:0 24rpx;text-align:right}.table-head{background:#eaf5ef;color:#72857c;font-size:22rpx}.table-head text:first-child,.table-row text:first-child{text-align:left}.table-row{border-bottom:1rpx solid #edf1ee;font-size:24rpx}.row-label{font-weight:700;font-size:27rpx}
