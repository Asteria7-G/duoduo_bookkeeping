<view class="page chart-page">
  <view class="safe-top"></view>
  <view class="nav"><view><view class="eyebrow">INSIGHTS</view><view class="nav-title big">收支图表</view></view><view class="type-switch"><view data-type="expense" bindtap="setType" aria-role="button" aria-label="查看支出图表" class="{{type === 'expense' ? 'active' : ''}}">支出</view><view data-type="income" bindtap="setType" aria-role="button" aria-label="查看收入图表" class="{{type === 'income' ? 'active income' : ''}}">收入</view></view></view>
  <view class="period-tabs"><view data-period="week" bindtap="setPeriod" aria-role="button" aria-label="查看本周" class="{{period === 'week' ? 'active' : ''}}">周</view><view data-period="month" bindtap="setPeriod" aria-role="button" aria-label="查看本月" class="{{period === 'month' ? 'active' : ''}}">月</view><view data-period="year" bindtap="setPeriod" aria-role="button" aria-label="查看本年" class="{{period === 'year' ? 'active' : ''}}">年</view></view>
  <view class="chart-card card">
    <view class="chart-summary"><view><text class="summary-label">{{type === 'expense' ? '总支出' : '总收入'}}</text><text class="summary-money money">¥ {{total}}</text></view><view class="average"><text>平均</text><text>¥ {{average}}</text></view></view>
    <canvas canvas-id="trendCanvas" id="trendCanvas" class="canvas" aria-label="{{type === 'expense' ? '支出' : '收入'}}趋势图，合计{{total}}元，平均{{average}}元"></canvas>
    <view class="axis"><text wx:for="{{labels}}" wx:key="*this" wx:if="{{period !== 'month' || index === 0 || index === 9 || index === 19 || index === labels.length - 1}}">{{item}}</text></view>
  </view>
  <view class="section-title">{{type === 'expense' ? '支出' : '收入'}}排行榜</view>
  <view wx:if="{{ranking.length}}" class="rank-card card"><view wx:for="{{ranking}}" wx:key="id" class="rank-row"><view class="rank-icon" style="background:{{item.category.color}}">{{item.category.icon}}</view><view class="rank-main"><view class="rank-info"><text>{{index + 1}}. {{item.category.name}}</text><text>{{item.percent}}%</text></view><progress-bar value="{{item.percent}}" color="{{type === 'expense' ? '#A95344' : '#425F40'}}"/></view><text class="rank-money money">{{item.amount}}</text></view></view>
  <view wx:else class="empty card"><view class="empty-face">ฅ^•ﻌ•^ฅ</view><view>这个周期还没有{{type === 'expense' ? '支出' : '收入'}}记录</view></view>
</view>
