.brand { display:flex; flex-direction:column; align-items:flex-start; color:var(--ink); }
.brand .eyebrow { font-size:17rpx; letter-spacing:3rpx; margin-bottom:4rpx; }
.brand-wordmark { display:flex; align-items:center; gap:4rpx; line-height:1.2; font-weight:650; letter-spacing:-1rpx; }
.dodo-character { display:flex; align-items:center; }
.dodo-duo { font-size:52rpx; }
.brand-suffix { font-size:48rpx; margin-left:4rpx; }
.brand-wordmark .brand-paw { flex:none; transform:scale(.74) rotate(-12deg); transform-origin:center; margin:5rpx -3rpx 0 -4rpx; }
.brand-paw .paw-pad,.brand-paw .paw-toe { background:#d990a1; }
.bill-link { flex:none; display:flex; align-items:center; justify-content:flex-end; gap:12rpx; min-height:88rpx; color:var(--mint-deep); font-size:24rpx; }
.bill-link text { font-size:30rpx; }
.ledger-heading { margin:16rpx 0 22rpx; }
.ledger-heading-row { display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.ledger-switch { flex:1; min-width:0; display:flex; align-items:center; min-height:88rpx; }
.ledger-name { min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:36rpx; font-weight:600; letter-spacing:-1rpx; }
.switch-mark { flex:none; margin-left:14rpx; color:var(--muted); font-size:26rpx; }
.ledger-caption { display:block; color:var(--muted); font-size:23rpx; margin-top:-4rpx; }
.overview { padding:18rpx 32rpx; border-radius:30rpx; color:#fffdf0; background:#303e2f; box-shadow:0 16rpx 32rpx rgba(37,52,36,.09); }
.overview-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.month-picker { min-height:64rpx; display:flex; align-items:center; gap:16rpx; font-size:25rpx; color:#e9eddd; }
.chev { color:#bec8af; }
.visibility-toggle { min-height:64rpx; display:flex; align-items:center; font-size:21rpx; color:#d1d9c7; }
.expense-caption { margin-top:0; color:#d1d9c7; font-size:24rpx; }
.expense-caption text { margin-left:16rpx; font-size:15rpx; letter-spacing:2rpx; }
.hero-amount { font-size:68rpx; font-weight:500; letter-spacing:-2rpx; line-height:1.2; margin:4rpx 0 18rpx; overflow-wrap:break-word; }
.currency { font-size:34rpx; margin-right:14rpx; color:#d1d9c7; }
.summary-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24rpx; }
.summary-grid > view + view { border-left:1rpx solid #54614b; padding-left:32rpx; }
.summary-label, .summary-value { display:block; }
.summary-label { font-size:22rpx; color:#d1d9c7; margin-bottom:4rpx; }
.summary-value { font-size:31rpx; font-weight:500; overflow-wrap:anywhere; }
.summary-value.negative { color:#ffc9b4; }
.budget-area { margin-top:18rpx; }
.budget-track { height:6rpx; background:#59634f; border-radius:8rpx; overflow:hidden; }
.budget-fill { height:100%; background:#e7ca85; border-radius:8rpx; }
.budget-fill.over { background:#f1b5a3; }
.budget-meta { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:10rpx; color:#d1d9c7; font-size:20rpx; }
.balance-note { margin-top:24rpx; padding-top:18rpx; border-top:1rpx solid #54614b; font-size:21rpx; color:#d1d9c7; }
.ledger-companion { margin-top:22rpx; min-height:178rpx; }
.detail-title { margin:34rpx 0 18rpx; display:flex; justify-content:space-between; align-items:center; font-size:30rpx; font-weight:650; }
.detail-dot { display:inline-block; width:9rpx; height:9rpx; border-radius:50%; background:#d7a8b0; margin:0 0 4rpx 10rpx; }
.count { font-size:22rpx; font-weight:400; color:var(--muted); }
.day-card { margin-bottom:18rpx; padding:0 24rpx; }
.day-head { min-height:82rpx; display:flex; align-items:center; justify-content:space-between; gap:12rpx; color:var(--muted); font-size:21rpx; border-bottom:1rpx solid var(--line); }
.day-date { color:var(--ink); font-weight:600; font-size:25rpx; margin-right:12rpx; }
.weekday { font-size:21rpx; }
.tx-row { display:flex; align-items:center; min-height:120rpx; gap:18rpx; }
.tx-entry { position:relative; overflow:hidden; }
.tx-entry + .tx-entry { border-top:1rpx solid #f0f0e8; }
.tx-content { position:relative; z-index:1; background:var(--surface); transform:translateX(0); transition:transform .18s ease-out; }
.tx-entry.is-open .tx-content { transform:translateX(-132rpx); }
.tx-delete { position:absolute; z-index:0; top:60rpx; right:16rpx; transform:translateY(-50%); box-sizing:border-box; width:88rpx; height:88rpx; min-width:44px; min-height:44px; margin:0; padding:0; border:0; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#dc4b4b; line-height:1; }
.tx-delete::after { border:0; }
.tx-delete:active { background:#c63c3c; }
.tx-delete-icon { display:block; flex:none; width:40rpx; height:40rpx; }
.tx-photos { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; padding:0 0 22rpx 86rpx; }
.tx-photo { flex:none; width:92rpx; height:92rpx; min-width:44px; min-height:44px; border:1rpx solid var(--line); border-radius:16rpx; background:#eeeee3; }
.tx-photo-hint { color:var(--muted); font-size:20rpx; line-height:1.5; }
.category-icon { flex:none; width:68rpx; height:68rpx; border-radius:24rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; }
.tx-main { flex:1; min-width:0; }
.tx-category, .tx-note { display:block; }
.tx-category { font-size:27rpx; font-weight:500; }
.tx-note { font-size:22rpx; color:var(--muted); margin-top:5rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.tx-amount { font-size:29rpx; font-weight:550; flex:none; max-width:52%; overflow-wrap:anywhere; text-align:right; }
.empty-face { margin-bottom:16rpx; color:#7a735c; }
.empty-tip { margin:24rpx auto 0; width:260rpx; }
