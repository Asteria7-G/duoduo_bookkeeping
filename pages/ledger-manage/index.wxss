.helper { color:var(--muted); margin:24rpx 0 28rpx; font-size:24rpx; line-height:1.7; }
.ledger-card { display:flex; align-items:center; gap:20rpx; padding:28rpx; margin-bottom:22rpx; border:2rpx solid transparent; }
.ledger-info { flex:1; min-width:0; }
.name { font-size:32rpx; font-weight:600; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.meta { margin-top:10rpx; color:var(--muted); font-size:23rpx; }
.check { flex:none; color:var(--mint-deep); font-size:32rpx; }
.edit { flex:none; min-width:44px; min-height:44px; display:flex; align-items:center; justify-content:flex-end; letter-spacing:4rpx; color:var(--muted); }
