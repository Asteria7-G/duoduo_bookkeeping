.settings { width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; color:#42583e; }
.profile-card { display:flex; align-items:center; padding:32rpx 0 36rpx; }
.avatar-frame { position:relative; box-sizing:border-box; flex:0 0 116rpx; width:116rpx; min-width:116rpx; max-width:116rpx; height:116rpx; min-height:116rpx; max-height:116rpx; }
.avatar-crop { position:absolute; top:0; left:0; width:116rpx; height:116rpx; border-radius:24rpx; overflow:hidden; background:#e8ecdd; }
.avatar-crop::after { content:""; position:absolute; top:0; left:0; right:0; bottom:0; box-sizing:border-box; border:2rpx solid #a4a98a; border-radius:24rpx; pointer-events:none; }
.avatar-crop .avatar-image { position:absolute; top:0; left:0; display:block; width:116rpx; height:116rpx; }
.profile-card .avatar-button { position:absolute; z-index:2; top:0; left:0; box-sizing:border-box; display:block; width:116rpx; max-width:116rpx; min-width:0; height:116rpx; min-height:0; padding:0; margin:0; border:0; border-radius:24rpx; background:transparent; opacity:0; line-height:normal; }
.avatar-button::after { border:0; }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; }
.cat-avatar { position:relative; width:64rpx; height:54rpx; border:3rpx solid #46553f; border-radius:40% 40% 46% 46%; color:#46553f; font-size:27rpx; line-height:54rpx; }
.cat-avatar::before,.cat-avatar::after { content:""; position:absolute; width:19rpx; height:22rpx; top:-12rpx; border-top:3rpx solid #46553f; background:#e8ecdd; }
.cat-avatar::before { left:-2rpx; border-left:3rpx solid #46553f; border-radius:3rpx; transform:rotate(15deg); }
.cat-avatar::after { right:-2rpx; border-right:3rpx solid #46553f; border-radius:3rpx; transform:rotate(-15deg); }
.cat-avatar text { position:relative; z-index:1; }
.camera { position:absolute; z-index:3; pointer-events:none; right:-4rpx; bottom:-4rpx; width:36rpx; height:36rpx; border:4rpx solid #f7f7ef; border-radius:50%; background:#42583e; color:#fffdf5; font-size:24rpx; line-height:34rpx; }
.profile-info { flex:1; min-width:0; margin-left:28rpx; }
.nickname { font-size:38rpx; font-weight:600; width:100%; }
.profile-tag { color:var(--muted); font-size:23rpx; margin-top:12rpx; }
.profile-hint { color:var(--muted); font-size:19rpx; margin-top:4rpx; }
.streak-card { display:flex; align-items:center; justify-content:space-between; gap:22rpx; padding:26rpx; background:#eeeee3; box-shadow:none; }
.streak-title { display:block; color:var(--muted); font-size:23rpx; }
.streak-number { font-size:58rpx; font-weight:500; }
.streak-unit { color:var(--muted); font-size:23rpx; }
.streak-copy { flex:1; padding-left:28rpx; border-left:1rpx solid #d8ddce; color:#5d6653; font-size:24rpx; line-height:1.8; }
.streak-copy text { display:block; }
.vip-card { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:22rpx; padding:28rpx 26rpx; border:1rpx solid #e9dfc5; border-radius:26rpx; background:#f3ead2; color:#5b4c2e; }
.vip-title { font-size:28rpx; font-weight:600; }
.vip-desc { font-size:21rpx; color:#766445; margin-top:8rpx; }
.vip-copy { flex:1; min-width:0; }
.vip-button { flex:none; font-size:23rpx; }
.menu { padding:0 24rpx; box-shadow:none; }
.menu-row { display:flex; align-items:center; min-height:132rpx; border-bottom:1rpx solid var(--line); gap:20rpx; }
.menu-row:last-child { border:0; }
.menu-icon { flex:none; width:50rpx; text-align:center; color:#637256; font-size:38rpx; }
.menu-main { flex:1; min-width:0; }
.menu-main text { display:block; }
.menu-main text:first-child { font-weight:500; font-size:28rpx; }
.menu-main text:last-child { font-size:22rpx; color:var(--muted); margin-top:5rpx; }
.menu-arrow { font-size:34rpx; color:#7d806e; }
.signoff-title { color:var(--ink); font-size:38rpx; font-weight:650; letter-spacing:3rpx; line-height:1.4; }
.signoff-credit { margin-top:6rpx; color:var(--muted); font-size:20rpx; letter-spacing:2rpx; }
